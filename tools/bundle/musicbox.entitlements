<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Used by tools/bundle/bundle.sh for Developer ID builds (hardened runtime). MP3 decoding loads
     libmpg123.0.dylib from the installed rekordbox app (docs/re/decode.md), which is signed by
     another team; library validation would refuse it. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
